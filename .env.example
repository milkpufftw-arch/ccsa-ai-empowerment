# All VITE_* variables are PUBLIC. Never place spreadsheet IDs, email, tokens or credentials here.
# Production uses only reviewed public/data/content.json. demo is for local demonstrations only.
VITE_CONTENT_MODE=published
# Optional override of src/config/site.ts. This is a public navigation URL, not a credential.
# An explicitly empty VITE_ADMIN_URL disables the link; changing it requires a new website build.
VITE_ADMIN_URL=https://script.google.com/macros/s/AKfycbzbuYPupTD3fHt9a9LkGTOQGPixP6eoYgKHTk1htNFKiOu2jKpVi3I7q5QX9i5GHonwbA/exec
